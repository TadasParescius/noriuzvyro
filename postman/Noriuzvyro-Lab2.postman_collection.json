{
  "info": {
    "name": "Noriuzvyro — Lab2 Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All URLs and JSON bodies are prefilled. Select No Environment and send requests 01–12 in order. JWT is saved automatically in collection variables. Keep the Postman cookie jar enabled. Registration generates a new sample email each time. To log in using an existing account, set testEmail and testPassword in the collection Variables tab and send request 03. Expected 401 and 403 responses demonstrate access protection; they are not application failures."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "testEmail",
      "value": "gynimas1@example.com"
    },
    {
      "key": "testPassword",
      "value": "Slaptazodis-123!"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "testUserId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 — Check API and database health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Register as buyer",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman pirkėjas\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('testEmail', 'postman-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', data.accessToken);",
              "  pm.collectionVariables.set('testUserId', String(data.user.id));",
              "  pm.test('Buyer role', () => pm.expect(data.user.role).to.eql('buyer'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Log in and save JWT",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', data.accessToken);",
              "  pm.collectionVariables.set('testUserId', String(data.user.id));",
              "  pm.test('Buyer role', () => pm.expect(data.user.role).to.eql('buyer'));",
              "}",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  const claims = JSON.parse(Buffer.from(data.accessToken.split('.')[1], 'base64').toString());",
              "  pm.test('JWT includes user ID and role', () => {",
              "    pm.expect(claims.sub).to.eql(String(data.user.id));",
              "    pm.expect(claims.role).to.eql('buyer');",
              "    pm.expect(claims.exp).to.be.above(claims.iat);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Get my account using JWT",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — No JWT returns 401",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Buyer cannot list users — 403",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/users",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Refresh tokens",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/refresh",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('accessToken', data.accessToken);",
              "  pm.collectionVariables.set('testUserId', String(data.user.id));",
              "  pm.test('Buyer role', () => pm.expect(data.user.role).to.eql('buyer'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "08 — Get my orders",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/my/orders",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 — Incorrect password returns 401",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Tycia-neteisingas-123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 — Log out",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 — Old JWT is invalid after logout — 401",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 — Refresh token is invalid after logout — 401",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/refresh",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
