{$SITE_ADDRESS::80} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    @api path /api /api/*
    handle @api {
        reverse_proxy api:3000
    }
    handle /health {
        reverse_proxy api:3000
    }
    handle /docs* {
        reverse_proxy api:3000
    }
    handle /openapi.json {
        reverse_proxy api:3000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
